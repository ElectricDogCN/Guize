      },
      "expectedResults": {
        "apply_tokens": {
          "background": "rgb(255, 255, 255)",
          "text": "rgb(34, 34, 34)",
          "padding": "8px"
        },
        "switch_theme": {
          "background": "rgb(30, 30, 30)",
          "text": "rgb(245, 245, 245)",
          "padding": "8px"
        }
      }
