          "phoneColumns": 1,
          "tabletColumns": 2
        },
        "touch_interaction": {
          "phone": [
            "Sample details",
            "Sample list"
          ],
          "tablet": [
            "Sample details",
            "Sample list"
          ]
        }
      }
    },
    {
      "scenarioId": "permission_model_equivalent",
      "fixtureId": "guize-admin-v1/permission_model_equivalent",
      "arguments": {
        "subjects": [
          {
            "id": "reader",
            "actions": [
              "read"
            ]
          },
          {
            "id": "editor",
            "actions": [
              "read",
              "edit"
            ]
          }
        ],
        "actions": [
          "read",
          "edit",
          "publish"
        ],
        "steps": [
          "Switch between fixture subjects",
          "Show the granted actions",
          "Keep the other actions unavailable"
        ]
      },
      "expectedResults": {
        "route_visibility": {
          "editor": "Current view: edit",
          "reader": "Current view: read"
        },
        "field_visibility": {
          "editor": true,
          "reader": false
        },
        "action_visibility": {
          "reader": [
            "read"
          ],
          "editor": [
            "read",
            "edit"
          ]
        },
        "server_authorization": {
          "reader": 403,
          "editor": 200
        }
      }
    },
    {
      "scenarioId": "design_token_equivalent",
      "fixtureId": "guize-admin-v1/design_token_equivalent",
      "arguments": {
        "themes": {
          "light": {
            "surface": "#ffffff",
            "text": "#222222"
          },
          "dark": {
            "surface": "#1e1e1e",
            "text": "#f5f5f5"
          }
        },
        "spacing": 8,
        "steps": [
          "Apply light tokens",
          "Switch to dark tokens",
