{
  "name": "guize-frontend-comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:react && npm run build:vue",
    "test": "node --test fixtures.test.mjs",
    "test:browser": "node --test browser.test.mjs",
    "measure:bundles": "node measure-bundles.mjs",
    "build:react": "vite build --mode react",
    "build:vue": "vite build --mode vue"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "vite": "6.4.2"
  }
}
