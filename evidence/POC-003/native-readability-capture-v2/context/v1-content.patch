+    def capture_readability(self,row):
+        """Read one observed Slice after timing/settling and before the next clear.
+
+        Keep the HTTP observation immutable. This separate native observation is
+        neither a new media request nor an additional lifecycle stage.
+        """
+        from cache_probe import export_stage
+        rid=row['requestId']
+        if not isinstance(rid,str) or len(rid)!=32 or any(c not in '0123456789abcdef' for c in rid):
+            raise ValueError('actual request identity required for native sidecar')
+        record=dict(kind='POST_RESPONSE_NATIVE_SLICE_READABILITY_UNASSESSED',requestId=rid,
+            httpObservationRef='observations/request-'+rid+'.json',startedAt=utc(),
+            originalRequestStartedAt=row['startedAt'],originalRequestFinishedAt=row['finishedAt'],
+            sourceVersion=row['sourceVersion'],sourceSha256=row['sourceSha256'],userId=row['userId'],
+            aclVersion=row['aclVersion'],requestRange=row['requestRange'],nativeReadAttempted=False,
+            readableSliceVerified=False,formalPocAccepted=False)
+        try:
+            version=row['sourceVersion'];source=self.cfg['inputs'][version]
+            code,first,last=interval(row['requestRange'],source['sizeBytes'],row['ifRange'],source['etag'])
+            expected_path='/ctx/'+context(self.cfg['aclVersion'],row['userId'])+'/'+version+'/object.bin'
+            transactions=row.get('originObservation',{}).get('gatewayTransactions',[])
+            eligible=(code==206 and row['statusCode']==206 and row['transportCompleted']
+                and row['aclVersion']==self.cfg['aclVersion'] and row['sourceSha256']==source['sha256']
+                and row['bodyBytes']==last-first+1
+                and not row.get('transportError') and not row.get('bodyPersistenceError')
+                and row.get('sourceIntervalComparison',{}).get('actualBytesEqual') is True
+                and row.get('originPollingSettled') is True and len(transactions)==1
+                and transactions[0].get('cacheContextPath')==expected_path
+                and transactions[0].get('finishedAt') is not None)
+            record.update(responseEligible=eligible,cacheContextPath=expected_path)
+            if not eligible:
+                record['unprovenReason']='protected response or actual same-context settling prerequisite not met'
+                return record
+            start=first//self.cfg['sliceBytes']*self.cfg['sliceBytes']
+            end=min(start+self.cfg['sliceBytes'],source['sizeBytes'])-1
+            if last>end:raise ValueError('readability sidecar requires a single requested Slice')
+            before=self.control('snapshot',stage='request-readability-before-'+rid)
+            record['controllerSnapshotBefore']=before
+            if before['sourceVersion']!=version:raise ValueError('source changed before native readability observation')
+            output=self.out/('cache-readability-'+rid)
+            report=export_stage(self.run,output,self.cfg,before,version,user=row['userId'],requested_slice=(start,end))
+            record.update(exportReportRef=(output/'native-stage.json').relative_to(self.out).as_posix(),
+                nativeReadAttempted=bool(report.get('nativeRequests')),nativeExport=report)
+            after=self.control('snapshot',stage='request-readability-after-'+rid)
+            record['controllerSnapshotAfter']=after
+            stable=(before['atsPid']==after['atsPid']==report['atsPid']
+                and before['sourceVersion']==after['sourceVersion']==report['sourceVersion']==version
+                and all(before[key]==after[key] for key in ('originRequestCount','originObjectReadBytes'))
+                and all(before[key]==after[key]==0 for key in ('activeOriginRequests','activeGatewayRequests'))
+                and report['originJournalUnchangedDuringExport'])
+            keys=report['selectedKeys'];exports=report['exports'];count=end-start+1
+            matches=(len(keys)==len(exports)==1 and (keys[0]['start'],keys[0]['end'])==(start,end)
+                and exports[0]['keyId']==keys[0]['keyId'] and exports[0]['lookupUrl']==keys[0]['lookupUrl']
+                and exports[0]['status']=='exported' and exports[0].get('exactInputSliceEqual') is True
+                and exports[0]['reportedObjectBytes']==exports[0]['exportedBytes']==exports[0].get('actualBytes')==count)
+            record.update(sameContextAndOriginUnchanged=stable,
+                readableSliceVerified=bool(stable and matches and report['nativeExportFinished']),
+                logicalWholeObjectVerified=report['completeLogicalObjectVerified'])
+            return record
+        except Exception as error:
+            record.update(errorType=type(error).__name__,error=str(error));raise
+        finally:
+            record['finishedAt']=utc()
+            sidecar=self.out/'observations'/('cache-readability-'+rid+'.json')
+            if sidecar.exists():raise ValueError('native readability sidecar already exists')
+            write_json(sidecar,record)
+            with self.lock:self.readability_observations.append(dict(requestId=rid,
+                observationRef=sidecar.relative_to(self.out).as_posix(),readableSliceVerified=record['readableSliceVerified']))
+            self.save()
+
