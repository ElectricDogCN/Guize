  "sourceFindings": [
    {
      "path": "poc/POC-03-ats-range/cache_probe.py",
      "lines": "88-96",
      "finding": "raw_write_all consumes the supplied view through bounded subviews until all bytes are written; noninteger, zero, negative or excessive write progress raises OSError. It does not silently accept a partial raw write."
    },
    {
      "path": "poc/POC-03-ats-range/cache_probe.py",
      "lines": "99-149",
      "finding": "Export/comparison replaces whole-Slice returned bytes with two fixed65536byte raw-I/O slots, guarded through __alloc__==65537. Export read counts are validated and bounded to remaining selected length plus one; exceeding original stat size or selected count rejects, as does final count differing from initial stat. Short reference reads are filled across repeated calls. Missing reference bytes or any later-block mismatch permanently prevents exactInputSliceEqual while all actual export bytes/hash remain retained. Only scalar metadata returns; every slot/view/raw stream is released or closed through context/finally boundaries."
    },
    {
      "path": "poc/POC-03-ats-range/cache_probe.py",
      "lines": "152-171,349-358",
      "finding": "Ordered assembly reuses one guarded65536byte raw slot across all parts, completes partial writes and counts/hashes only actual bytes. The original full size and SHA equality remain prerequisites to completeLogicalObjectVerified; no nativeSingleEntry claim is introduced."
    },
    {
      "finding": "The prior bound and export-lifetime methods are adapted to the removed whole-Slice API by checking actual output files plus metadata. Exact/partial/empty bytes, oversize-before-open, growth rejection without trimming native originals, adjacent-key release, source-read error and write-failure-before-reference-open obligations remain. Three exact prior source/test preimages match parent Git blobs; no old failure or old assertion obligation is silently discarded."
    },
    {
      "path": "poc/POC-03-ats-range/test_cache_stream_io.py",
      "finding": "Six actual raw-file cases cover multiple blocks with asymmetric short reads and partial writes, short reference, a later-block mismatch, zero-progress write refusing reference open, real retained bytearray over-allocation rejection before media read, and one assembly slot across multiple/empty parts with final release."
    }
  ],
  "changedFailureArtifactTiming": {
    "partialDestinationMayRemain": true,
    "interpretation": "Streaming may write a valid prefix before discovering later growth, shrinkage, source error or write failure. The function then raises; export_stage retains a distinct failure record/raw and rethrows, without returning normal observation or a successful logical-object record. Native original exports are not trimmed or rewritten. This differs from the old whole-read-before-write failure artifact timing and is not represented as transactional output rollback."
  },
