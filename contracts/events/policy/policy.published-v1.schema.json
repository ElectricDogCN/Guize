{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guize.local/contracts/events/policy/policy.published-v1.schema.json",
  "title": "policy.published version1",
  "allOf": [
    {
      "$ref": "https://guize.local/contracts/events/event-envelope.schema.json"
    },
    {
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Opaque resource identifier; never a file path.",
          "x-i18n": {
            "en-US": {
              "description": "Opaque resource identifier; never a file path."
            },
            "zh-CN": {
              "description": "不透明资源标识，不是文件路径。"
            }
          },
          "pattern": "^[a-z]{2,12}_[A-Za-z0-9_-]{1,64}$",
          "maxLength": 80
        },
        "eventType": {
          "const": "policy.published"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "PolicyDefinition"
        },
        "aggregateId": {
          "type": "string",
          "description": "Opaque resource identifier; never a file path.",
          "x-i18n": {
            "en-US": {
              "description": "Opaque resource identifier; never a file path."
            },
            "zh-CN": {
              "description": "不透明资源标识，不是文件路径。"
            }
          },
          "pattern": "^[a-z]{2,12}_[A-Za-z0-9_-]{1,64}$",
          "maxLength": 80
        },
        "producer": {
          "const": "guize-control"
        },
        "traceId": {
          "type": "string",
          "description": "Request correlation identifier, including failures.",
          "x-i18n": {
            "en-US": {
              "description": "Request correlation identifier, including failures."
            },
            "zh-CN": {
              "description": "包括失败请求在内的关联标识。"
            }
          },
          "pattern": "^[A-Za-z0-9-]{8,128}$",
          "maxLength": 128
        },
        "payload": {
          "type": "object",
          "properties": {
            "policyId": {
              "type": "string",
              "description": "Opaque resource identifier; never a file path.",
              "x-i18n": {
                "en-US": {
                  "description": "Opaque resource identifier; never a file path."
                },
                "zh-CN": {
                  "description": "不透明资源标识，不是文件路径。"
                }
              },
              "pattern": "^[a-z]{2,12}_[A-Za-z0-9_-]{1,64}$",
              "maxLength": 80
            },
            "policyVersionId": {
              "type": "string",
              "description": "Opaque resource identifier; never a file path.",
              "x-i18n": {
                "en-US": {
                  "description": "Opaque resource identifier; never a file path."
                },
                "zh-CN": {
                  "description": "不透明资源标识，不是文件路径。"
                }
              },
              "pattern": "^[a-z]{2,12}_[A-Za-z0-9_-]{1,64}$",
              "maxLength": 80
            },
            "revision": {
              "type": "integer",
              "description": "Optimistic resource revision.",
              "x-i18n": {
                "en-US": {
                  "description": "Optimistic resource revision."
                },
                "zh-CN": {
                  "description": "资源的乐观并发修订号。"
                }
              },
              "minimum": 1
            },
            "schemaVersion": {
              "type": "integer",
              "description": "Optimistic resource revision.",
              "x-i18n": {
                "en-US": {
                  "description": "Optimistic resource revision."
                },
                "zh-CN": {
                  "description": "资源的乐观并发修订号。"
                }
              },
              "minimum": 1
            },
            "state": {
              "const": "PUBLISHED"
            },
            "definitionHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "publishedAt": {
              "type": "string",
              "description": "UTC RFC3339 timestamp.",
              "x-i18n": {
                "en-US": {
                  "description": "UTC RFC3339 timestamp."
                },
                "zh-CN": {
                  "description": "UTC RFC3339 时间。"
                }
              },
              "format": "date-time"
            }
          },
          "required": [
            "policyId",
            "policyVersionId",
            "revision",
            "schemaVersion",
            "state",
            "definitionHash",
            "publishedAt"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
